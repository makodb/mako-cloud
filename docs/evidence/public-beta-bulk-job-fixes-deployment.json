    "findings": [
      {
        "pullRequest": 4,
        "issue": "At 99 or 100 stored row errors, the proposed diagnostic could be dropped.",
        "resolution": "Keep the earliest row errors and reserve the last two entries for the latest worker outcome and closed failure category.",
        "tests": [
          "worker_failure_diagnostics_survive_full_row_error_lists",
          "persisted_worker_diagnostics_exclude_sensitive_remote_fields"
        ]
      },
      {
        "pullRequest": 11,
        "issue": "The proposed larger export pages exceed the encrypted response journal limit of 1 MiB and still fail in the authenticated handler.",
        "resolution": "Bound the encrypted journal at the same 4 MiB allowance as the control-plane HTTP client; retain the 2 MiB export page limit.",
        "tests": [
          "exports_large_documents_without_omitting_or_duplicating_page_boundaries",
          "response_journal_accepts_large_export_pages_but_keeps_a_finite_bound",
          "control_data_client_accepts_export_pages_and_rejects_oversized_responses"
        ]
      }
    ],
    "scope": "PR4 improves diagnostics without changing retries, writes, or conflict strategies. PR11 fixes bounded export page, HTTP response, and response journal sizes without raising document or request limits.",
