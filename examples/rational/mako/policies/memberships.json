{
  "version": 1,
  "rules": [
    {
      "id": "members-read",
      "effect": "allow",
      "operations": ["read"],
      "expression": "claims.households[old.household_id] != null"
    },
    {
      "id": "invited-read",
      "effect": "allow",
      "operations": ["read"],
      "expression": "old.status == \"invited\" && old.email == identity.email && identity.email_verified"
    }
  ]
}
