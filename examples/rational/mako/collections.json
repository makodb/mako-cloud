            "minimum": 0,
            "maximum": 9007199254740991,
            "multipleOf": 1
          },
          "updated_at": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "multipleOf": 1
          },
          "user_id": {
            "type": "string",
            "maxLength": 128
          },
          "email": {
            "type": "string",
            "maxLength": 320
          },
          "role": {
            "type": "string",
            "enum": ["owner", "editor", "viewer"],
            "maxLength": 32
          },
          "status": {
            "type": "string",
            "enum": ["active", "invited", "accepted", "removed"],
            "maxLength": 32
          },
          "invited_by": {
            "type": "string",
            "maxLength": 128
          }
        },
        "required": ["id", "household_id", "created_at", "updated_at", "user_id", "role", "status"]
      },
      "primaryKey": {
        "kind": "field",
        "field": "id"
      },
      "indexes": [
        {
          "name": "household_updated",
          "fields": ["household_id", "updated_at"]
        },
        {
          "name": "user_updated",
          "fields": ["user_id", "updated_at"]
        }
      ]
    },
