{
  "$comment": "Single source of the Rational document model. scripts/bootstrap.mjs publishes jsonSchema, primaryKey, and indexes to the platform; src/model/collections.ts derives the RxDB schemas from the same object. Amounts are integer minor units with an ISO 4217 currency; timestamps are unix milliseconds; deletion is RxDB's _deleted. Small document types share a collection with a kind discriminator (taxonomy, alerts, connections) because RxDB's open-source build opens at most 13 collections per page.",
  "schemaVersion": 3,
  "collections": [
    {
      "id": "households",
      "scope": "directory",
      "description": "A household. The `updated` index is what lets the nightly function walk every household: a query with no predicate names no index and is refused, so enumeration is a range over one. budget_mode is how the budget page presents the same budgets (schema v3).",
      "jsonSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1
          },
          "household_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1
          },
          "created_at": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "multipleOf": 1
          },
          "updated_at": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "multipleOf": 1
          },
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3,
            "pattern": "^[A-Z]{3}$"
          },
          "owner_id": {
            "type": "string",
            "maxLength": 128
          },
          "budget_mode": {
            "type": "string",
            "enum": ["category", "flex"],
            "maxLength": 32
          }
        },
        "required": [
          "id",
          "household_id",
          "created_at",
          "updated_at",
          "name",
          "currency",
          "owner_id"
        ]
      },
      "primaryKey": {
        "kind": "field",
        "field": "id"
      },
      "indexes": [
        {
          "name": "household_updated",
          "fields": ["household_id", "updated_at"]
        },
        {
          "name": "updated",
          "fields": ["updated_at"]
        }
      ]
    },
    {
      "id": "memberships",
      "scope": "directory",
      "description": "Readable projection of a member's claim; id is <household_id>.<user_id> for a member and <household_id>.invite.<digest of the email> for a pending invitation, whose user_id is empty until it is accepted; written only by the households function.",
      "jsonSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1
          },
