{
  "name": "@mako-cloud/example-rational",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "build": "tsc -b && vite build",
    "dev": "vite --host 127.0.0.1",
    "seed": "node scripts/seed.mjs",
    "test:browser": "playwright test",
    "test:browser-live": "playwright test --config playwright.live.config.ts",
    "test:unit": "npm run build && node --test test-unit/*.test.mjs",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.test.json --pretty false"
  },
  "dependencies": {
    "@mako-cloud/rxdb": "*",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "rxdb": "17.4.0",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "vite": "^7.3.6"
  }
}
