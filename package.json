{
  "name": "mako-cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "build:public-beta-release": "node scripts/build-public-beta-release.js",
    "collect:public-beta-measurement": "node scripts/collect-public-beta-measurement-snapshot.js",
    "clean": "tsc -b --clean",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "generate:api": "openapi-typescript api/openapi/mako-cloud-v1.yaml --output packages/api-types/src/generated/schema.ts",
    "generate:api:check": "openapi-typescript api/openapi/mako-cloud-v1.yaml --output packages/api-types/src/generated/schema.ts --check",
    "generate:public-beta-inventory": "node scripts/proxmox/generate-public-beta-inventory.js",
    "lint": "biome lint .",
    "benchmark": "bash scripts/run-performance-benchmarks.sh",
    "benchmark:public-beta-pre-admission": "node scripts/run-public-beta-pre-admission-benchmark.js",
    "benchmark:public-beta-hosted": "node scripts/run-public-beta-hosted-benchmark.js",
    "typecheck": "tsc -b --pretty false",
    "validate:observability": "node scripts/validate-observability-assets.js",
    "validate:operator-auth-assets": "node scripts/validate-operator-auth-assets.js",
    "validate:docs": "node scripts/validate-documentation.js",
    "validate:performance": "node scripts/validate-performance-baseline.js",
    "validate:production-storage": "node scripts/validate-production-storage.js",
    "validate:public-beta-caddy": "node scripts/validate-public-beta-caddy.js",
    "validate:public-beta-containers": "node scripts/validate-public-beta-containers.js",
    "validate:public-beta-infrastructure": "node scripts/validate-public-beta-infrastructure.js",
    "validate:public-beta-local": "node scripts/validate-public-beta-local.js",
    "validate:public-beta-services": "node scripts/validate-public-beta-services.js",
    "validate:proxmox-image": "node scripts/proxmox/validate-public-beta-image.js",
    "validate:production-release": "node scripts/validate-production-release.js",
    "validate:release-gates": "node scripts/validate-release-gates.js",
    "validate:rollback": "node scripts/validate-rollback-qualification.js",
    "validate:traceability": "node scripts/validate-requirements-traceability.js",
    "test": "npm run test --workspaces --if-present",
    "test:auth-security": "bash scripts/run-auth-security-qualification.sh",
    "test:public-beta-hosted": "node scripts/run-public-beta-hosted-qualification.js",
    "test:public-beta-operator-browser": "node scripts/run-public-beta-operator-browser-qualification.js",
    "test:public-beta-streaming": "node scripts/run-public-beta-streaming-qualification.js",
    "test:edge-security": "bash scripts/run-edge-security-qualification.sh",
    "test:e2e-smoke": "bash scripts/run-e2e-smoke-qualification.sh",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "test:policy-security": "bash scripts/run-policy-security-qualification.sh",
    "test:proxmox-plan": "node --test scripts/proxmox/test/public-beta-plan.test.js",
    "test:proxmox-apply": "node --test scripts/proxmox/test/public-beta-apply.test.js",
    "test:proxmox-teardown": "node --test scripts/proxmox/test/public-beta-teardown.test.js",
    "test:public-beta-preview": "node --test scripts/test/public-beta-preview-*.test.js",
    "test:operator-session-cleanup": "node --test scripts/test/operator-session-cleanup.test.js",
    "test:operator-auth": "bash scripts/run-operator-auth-qualification.sh",
    "scan:public-beta-secrets": "node scripts/scan-public-beta-secrets.js",
    "proxmox:public-beta": "node scripts/proxmox/public-beta-apply.js",
    "proxmox:public-beta-firewall": "bash scripts/proxmox/install-public-beta-host-firewall.sh",
    "plan:public-beta-teardown": "node scripts/proxmox/public-beta-teardown-plan.js",
    "public-beta:preview-approval": "node scripts/public-beta-preview-approval.js",
    "render:proxmox-cloud-init": "node scripts/proxmox/render-public-beta-cloud-init.js",
    "test:rxdb-chaos": "bash scripts/run-rxdb-chaos-qualification.sh",
    "test:rollback": "bash scripts/run-rollback-qualification.sh",
    "test:storage-soak": "bash scripts/run-storage-soak-qualification.sh",
    "test:tenant-boundaries": "bash scripts/run-tenant-boundary-qualification.sh",
    "test:browser-live": "npm run test:browser-live --workspace @mako-cloud/example-local-first"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "openapi-typescript": "7.13.0",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "js-yaml": "4.3.1"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  }
}
