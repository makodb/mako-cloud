MAKO_ENVIRONMENT=local
MAKO_REGION=local
# Bind address is per-service. Left unset so each service uses its own default
# (data plane 127.0.0.1:8080, control plane 127.0.0.1:8081). Export it only when
# running a single service on a different port.
# MAKO_BIND_ADDR=127.0.0.1:8080
MAKO_ROCKSDB_PATH=.local/data/mako-data-plane/rocksdb
MAKO_ROCKSDB_MAX_BATCH_OPERATIONS=10000
MAKO_ROCKSDB_MAX_SCAN_ITEMS=10000
MAKO_ROCKSDB_LOCK_TIMEOUT_SECONDS=2
MAKO_ROCKSDB_TRANSACTION_EXPIRATION_SECONDS=30
MAKO_ROCKSDB_BACKUP_DESTINATION=.local/backups/mako-data-plane
MAKO_ROCKSDB_BACKUP_RETENTION_COUNT=14
MAKO_ROCKSDB_DISK_WARNING_FREE_BYTES=536870912
MAKO_ROCKSDB_DISK_CRITICAL_FREE_BYTES=268435456
MAKO_TLS_CA_PATH=.local/certs/ca.crt
MAKO_TLS_CERT_PATH=.local/certs/server.crt
MAKO_TLS_KEY_PATH=.local/certs/server.key
MAKO_SMTP_ENDPOINT=127.0.0.1:1025
MAKO_OBJECT_STORE_ENDPOINT=http://127.0.0.1:8333
MAKO_DATA_PLANE_ENDPOINT=127.0.0.1:8080
MAKO_EDGE_GATEWAY_ENDPOINT=127.0.0.1:8082
MAKO_RUNTIME_SUPERVISOR_ENDPOINT=127.0.0.1:9001
MAKO_TELEMETRY_QUERY_ENDPOINT=127.0.0.1:9465
MAKO_OTLP_ENDPOINT=127.0.0.1:4317
MAKO_MAX_REQUEST_BYTES=1048576
MAKO_SHUTDOWN_GRACE_SECONDS=30

# Control-plane operator authentication. Break-glass bearer access is fail-closed.
MAKO_OPERATOR_PASSWORD_AUTH_ENABLED=false
MAKO_OPERATOR_SESSION_TTL_SECONDS=3600
MAKO_OPERATOR_MUTATION_FRESHNESS_SECONDS=300
MAKO_OPERATOR_ATTEMPT_WINDOW_SECONDS=900
MAKO_OPERATOR_SOURCE_RATE_LIMIT=20
MAKO_OPERATOR_IDENTITY_RATE_LIMIT=10
MAKO_OPERATOR_BASE_BACKOFF_SECONDS=1
MAKO_OPERATOR_MAX_BACKOFF_SECONDS=300
MAKO_OPERATOR_BREAK_GLASS_BEARER_ENABLED=false

# Secret references. Values must be references; inline secrets are rejected.
# scripts/local/prepare.sh generates these files. Paths are relative to the
# repository root, so run the services from there.
# The data plane requires internal auth; the control plane also requires the
# object-store keys.
MAKO_INTERNAL_AUTH_SECRET_REF=file:.local/secrets/internal-auth
MAKO_OBJECT_STORE_ACCESS_KEY_REF=file:.local/secrets/object-store-access-key
MAKO_OBJECT_STORE_SECRET_KEY_REF=file:.local/secrets/object-store-secret-key
MAKO_OPERATOR_DIAGNOSTIC_ORIGINS=
MAKO_OPERATOR_BACKUP_EVIDENCE_JSON=[]
MAKO_OPERATOR_RECOVERY_CREATE_ENABLED=false
MAKO_OPERATOR_RECOVERY_PROMOTE_ENABLED=false
