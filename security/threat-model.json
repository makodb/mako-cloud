      "detect": ["scope mismatch counters", "storage access audit sampling"],
      "respond": ["deny request", "revoke workload grant", "isolate affected environment"],
      "verify": ["SEC-SCOPE-001", "SEC-STORAGE-BOUNDARY-001"]
    },
