{
  "version": 1,
  "review": {
    "owners": ["security", "data-platform", "identity", "edge-runtime"],
    "cadence": "before each production release and after material architecture changes"
  },
  "trust_boundaries": [
    {
      "id": "TB-01",
      "name": "Untrusted clients to public gateways",
      "entry_controls": [
        "TLS",
        "request limits",
        "authentication",
        "rate limits",
        "schema validation"
      ]
    },
    {
      "id": "TB-02",
      "name": "Gateway to control and data planes",
      "entry_controls": [
        "service identity",
        "project and environment scope",
        "least-privilege routes"
      ]
    },
    {
      "id": "TB-03",
      "name": "Data services to ordered transactional KV storage",
      "entry_controls": [
        "capability handshake",
        "tenant key prefixes",
        "bounded scans",
        "transaction conformance"
      ]
    },
    {
      "id": "TB-04",
      "name": "Services to email, object storage, and telemetry dependencies",
      "entry_controls": ["scoped credentials", "allowlisted endpoints", "redaction", "timeouts"]
    },
    {
      "id": "TB-05",
      "name": "Edge supervisor to tenant function isolates",
      "entry_controls": [
        "fresh isolate",
        "resource quotas",
        "capability-based secrets",
        "network policy"
      ]
    },
    {
      "id": "TB-06",
      "name": "Organization members and operators to privileged management paths",
      "entry_controls": [
        "RBAC",
        "step-up authentication",
        "reason and case binding",
        "immutable audit"
      ]
    },
    {
      "id": "TB-07",
      "name": "Source and dependencies to release artifacts",
      "entry_controls": [
        "protected CI",
        "lockfile audit",
        "reproducible build metadata",
        "artifact signing"
      ]
    },
    {
      "id": "TB-08",
      "name": "Control-plane configuration to regional runtime state",
      "entry_controls": [
        "versioning",
        "idempotent provisioning",
        "authorized promotion",
        "rollback"
      ]
    },
    {
      "id": "TB-09",
      "name": "Developer console through explorer capability to customer document data",
      "entry_controls": [
        "short-lived signed capability",
        "tenant collection mode and operation binding",
        "current authorization epoch and revocation",
        "policy-preview or audited administrative authorization"
      ]
    },
    {
      "id": "TB-10",
      "name": "Control-plane process and offline recovery tools to local SQLite authority",
      "entry_controls": [
        "exclusive process lock and database identity",
        "private service-owned paths",
        "authenticated migration and backup manifests",
        "schema integrity and capacity gates"
      ]
    }
  ],
  "privileged_identities": [
    {
      "id": "PI-01",
      "name": "Provisioning controller",
      "least_privilege": "May reconcile only the project and environment named by a durable workflow step",
      "credential": "short-lived workload identity"
    },
    {
      "id": "PI-02",
      "name": "Public gateway service",
      "least_privilege": "May authenticate and route requests but cannot bypass data-plane policy evaluation",
      "credential": "short-lived workload identity"
    },
    {
      "id": "PI-03",
      "name": "Data-plane service",
      "least_privilege": "May access only assigned environment key ranges and may not mint operator credentials",
      "credential": "short-lived workload identity plus storage grant"
    },
    {
      "id": "PI-04",
      "name": "Control-plane service",
      "least_privilege": "May mutate management state but cannot directly read customer document bodies",
      "credential": "short-lived workload identity"
    },
    {
      "id": "PI-05",
      "name": "Edge runtime supervisor",
      "least_privilege": "May create constrained isolates and inject only the selected project function secret set",
      "credential": "short-lived workload identity"
    },
    {
      "id": "PI-06",
      "name": "Break-glass support operator",
      "least_privilege": "Time-bound, approved, case-bound access with impersonation banners and enhanced audit",
      "credential": "phishing-resistant MFA and just-in-time grant"
    },
    {
      "id": "PI-07",
      "name": "Release automation",
      "least_privilege": "May publish signed artifacts from protected commits but has no production data access",
      "credential": "federated CI identity"
    },
    {
      "id": "PI-08",
      "name": "Explorer administrative capability",
      "least_privilege": "May perform only named operations against one tenant collection for at most five minutes after current role revalidation",
      "credential": "in-memory signed nonce and authorization-epoch-bound capability"
    },
    {
      "id": "PI-09",
      "name": "Control storage migration and recovery operator",
      "least_privilege": "May inspect fenced artifacts and publish only verified empty SQLite migration or restore targets",
      "credential": "root-readable manifest authentication material and explicit offline operation confirmation"
    }
  ],
  "sensitive_data_classes": [
    {
      "id": "SD-01",
      "name": "Credentials and secret values",
      "handling": "envelope-encrypted, referenced rather than embedded, always redacted",
      "retention": "delete on revocation subject to encrypted backup expiry"
    },
    {
      "id": "SD-02",
      "name": "Passwords, sessions, tokens, and identity links",
      "handling": "modern password hashing, hashed refresh state, audience and project binding",
      "retention": "minimum required for active sessions and abuse investigation"
    },
    {
      "id": "SD-03",
      "name": "Customer documents, revisions, indexes, and change records",
      "handling": "project/environment isolation and uniform document-policy enforcement",
      "retention": "project policy plus replication tombstone safety window"
    },
    {
      "id": "SD-04",
      "name": "Schemas, policies, and project configuration",
      "handling": "versioned, authorized, validated, and atomically activated",
      "retention": "retain versions needed for audit and rollback"
    },
    {
      "id": "SD-05",
      "name": "Audit and security events",
      "handling": "append-only, integrity protected, access restricted, body redacted",
      "retention": "security and contractual retention policy"
    },
    {
      "id": "SD-06",
      "name": "Function source, bundles, secrets, and invocation logs",
      "handling": "digest-bound artifacts, isolated execution, redacted logs",
      "retention": "deployed versions plus configured rollback and log windows"
    },
    {
      "id": "SD-07",
      "name": "Organization membership, billing, and support records",
      "handling": "management RBAC, purpose limitation, operator audit",
      "retention": "business and legal requirements"
    },
    {
      "id": "SD-08",
      "name": "Metrics, traces, IP addresses, and operational metadata",
      "handling": "bounded labels, pseudonymous identifiers, no document or secret payloads",
      "retention": "short operational window unless attached to a security case"
    },
    {
      "id": "SD-09",
      "name": "Operator incidents, recovery jobs, projections, and activity exports",
      "handling": "metadata-only, reason and case bound, integrity protected, no document bodies or secrets",
      "retention": "incident and audit policy; exports expire within one hour"
    },
    {
      "id": "SD-10",
      "name": "Explorer grants, data jobs, import uploads, and export artifacts",
      "handling": "tenant-bound, digest-verified, bounded, encrypted, expiring, and never persisted in browser storage",
      "retention": "capabilities at most five minutes; artifacts and job detail only for their declared bounded retention"
    },
    {
      "id": "SD-11",
      "name": "SQLite control database migration receipts and backup manifests",
      "handling": "private files, authenticated manifests, byte-exact inventories, integrity checks, and no customer values in evidence",
      "retention": "control database by account policy; receipts and verified backups by migration and recovery policy"
    }
  ],
  "abuse_cases": [
    {
      "id": "AC-01",
      "title": "Cross-tenant key or range access",
      "owner": "data-platform",
      "assets": ["SD-03", "SD-04"],
      "boundaries": ["TB-02", "TB-03"],
      "privileged_identities": ["PI-02", "PI-03"],
      "prevent": [
        "typed project/environment scope",
        "non-escapable encoded key prefixes",
        "bounded range scans"
