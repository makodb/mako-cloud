[Unit]
Description=Mako Cloud public-beta Grafana
PartOf=mako-dependencies.target
Before=mako-dependencies.target
ConditionPathExists=/home/mako-runtime/.config/mako-cloud/grafana.env

[Container]
Image=docker.io/grafana/grafana@sha256:121a7a9ece6dc10b969f1f96eed64b4f07dfac0d0b8abc070f7cb83bbde86f63
Pull=never
ContainerName=mako-grafana
Network=mako-cloud.network
User=0
Environment=GF_AUTH_ANONYMOUS_ENABLED=false
Environment=GF_AUTH_DISABLE_LOGIN_FORM=false
Environment=GF_USERS_ALLOW_SIGN_UP=false
Environment=GF_SECURITY_DISABLE_GRAVATAR=true
Environment=GF_SECURITY_COOKIE_SECURE=true
Environment=GF_SECURITY_ADMIN_USER=mako-admin
EnvironmentFile=/home/mako-runtime/.config/mako-cloud/grafana.env
Volume=/home/mako-runtime/.config/mako-cloud/grafana-provisioning:/etc/grafana/provisioning:ro
Volume=/home/mako-runtime/.config/mako-cloud/grafana-dashboards:/etc/grafana/dashboards:ro
Volume=mako-grafana.volume:/var/lib/grafana
PublishPort=127.0.0.1:3000:3000
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
Tmpfs=/tmp:rw,noexec,nosuid,nodev,size=64m
Tmpfs=/var/log/grafana:rw,noexec,nosuid,nodev,size=64m
LogDriver=journald
PodmanArgs=--init --pids-limit=256
Label=io.mako.environment=public-beta

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStopSec=60s
MemoryMax=1G
CPUQuota=100%
