[Unit]
Description=Mako Cloud public-beta pinned Supabase Edge Runtime
PartOf=mako-dependencies.target
Before=mako-dependencies.target

[Container]
Image=docker.io/supabase/edge-runtime@sha256:c52405002a890ca9fcf77978671c57f3a988e03174afb277f84ac65bc917013c
Pull=never
ContainerName=mako-edge-runtime
# The one container that must reach the host's loopback, because the platform
# API it hands every worker as MAKO_API_URL binds there and nowhere else. On
# the private bridge `host.containers.internal` was the bridge gateway, where
# no Mako service listens, so every SDK call a deployed function made was
# refused -- the documented way to write a function could not work at all.
#
# `allow_host_loopback` makes the host's loopback reachable at 10.0.2.2, and
# `outbound_addr=127.0.0.1` binds the container's outbound source there, so it
# reaches this machine's services and nothing beyond them -- which is what the
# private bridge was protecting. Published ports are unaffected, and the
# per-worker sandbox still grants tenant code exactly one host:port.
Network=slirp4netns:allow_host_loopback=true,outbound_addr=127.0.0.1,enable_ipv6=false
# The per-function wall limit is the real bound, enforced per worker by the
# supervisor; this outer timeout only catches a hung supervisor. It must sit
# above the largest wall limit the platform allows (300000ms) plus grace --
# at 5000 it silently killed every function whose honest work passed five
# seconds, as a bare invocation_failed nothing could explain.
Exec=start --policy per_request --user-worker-request-idle-timeout 330000 --main-service /home/deno/functions/main
Environment=DENO_DIR=/tmp/deno-cache
Environment=EDGE_RUNTIME_PORT=9000
Environment=MAKO_API_URL=http://host.containers.internal:8080
Environment=MAKO_ENTRYPOINT=index.ts
Environment=MAKO_ENVIRONMENT_ID=env_beta_canary
Environment=MAKO_FUNCTION_NAME=health
Environment=MAKO_FUNCTION_PATH=/home/deno/functions/canary
Environment=MAKO_JWT_AUDIENCE=
Environment=MAKO_JWT_ISSUER=
Environment=MAKO_JWKS=
Environment=MAKO_PROJECT_ID=prj_beta_canary
Environment=MAKO_RUNTIME_REGION=us-east-1-beta
Environment=MAKO_RUNTIME_STATE_PATH=/var/lib/mako-runtime-supervisor
Environment=MAKO_RUNTIME_WORKER_PATH=/var/lib/mako-runtime-workers
EnvironmentFile=/home/mako-runtime/.config/mako-cloud/runtime-supervisor.env
Environment=MAKO_USER_ENV_NAMES=[]
Environment=MAKO_VERIFY_JWT=false
Environment=MAKO_WALL_TIME_MS=5000
Volume=/home/mako-runtime/.config/mako-cloud/edge-runtime/main:/home/deno/functions/main:ro
Volume=/home/mako-runtime/.config/mako-cloud/edge-runtime/canary:/home/deno/functions/canary:ro
Volume=mako-edge-runtime.volume:/var/lib/mako-runtime-supervisor
PublishPort=127.0.0.1:9000:9000
PublishPort=127.0.0.1:9001:9000
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
Tmpfs=/tmp:rw,noexec,nosuid,nodev,size=256m
Tmpfs=/var/lib/mako-runtime-workers:rw,noexec,nosuid,nodev,size=256m
LogDriver=journald
# `--add-host`: the name the runtime injects as MAKO_API_URL, and the only
# http host the worker SDK accepts, pointed at the host address of the
# network above rather than at this machine's external address, which is
# what podman writes for that name by default.
PodmanArgs=--init --pids-limit=256 --add-host=host.containers.internal:10.0.2.2
Label=io.mako.environment=public-beta
Label=io.mako.runtime-protocol=1

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
MemoryMax=2G
CPUQuota=200%
