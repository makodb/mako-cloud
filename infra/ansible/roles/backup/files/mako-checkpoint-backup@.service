[Unit]
Description=Mako Cloud signed checkpoint backup for %i
After=local-fs.target
RequiresMountsFor=/opt/mako/current /srv/mako-data/rocksdb/data-plane /srv/mako-data/sqlite/control-plane/live /srv/mako-data/backup-staging/%i /srv/mako-data/backup-publish/%i
ConditionPathExists=/opt/mako/current/bin/mako-storage-ops
ConditionPathExists=/etc/mako/credentials/backup-signing-key
ConditionPathExists=/etc/mako/credentials/backup_id_ed25519
ConditionPathExists=/etc/mako/backup-known-hosts
StartLimitIntervalSec=900
StartLimitBurst=2

[Service]
Type=oneshot
User=mako-%i
Group=mako-%i
ExecStart=/usr/local/sbin/mako-checkpoint-backup %i
LoadCredential=backup-signing-key:/etc/mako/credentials/backup-signing-key
LoadCredential=backup-ssh-key:/etc/mako/credentials/backup_id_ed25519
LoadCredential=backup-known-hosts:/etc/mako/backup-known-hosts
TimeoutStartSec=10min
TimeoutStopSec=60s
KillMode=mixed
OOMPolicy=stop
UMask=0077
ReadWritePaths=/srv/mako-data/rocksdb/data-plane /srv/mako-data/sqlite/control-plane/live /srv/mako-data/backup-staging/%i /srv/mako-data/backup-publish/%i
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateIPC=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
IPAddressDeny=any
IPAddressAllow=130.245.173.105
DevicePolicy=closed
Nice=10
CPUWeight=10
IOWeight=10
TasksMax=128
LimitNOFILE=1048576
