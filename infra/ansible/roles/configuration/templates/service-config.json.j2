{
  "deployment": {
    "environment": "production",
    "region": "{{ mako_storage_region }}"
  },
  "server": {
    "bind_address": "127.0.0.1:{{ item.port }}",
    "public_url": "https://{{ mako_public_fqdn }}"
  },
{% if item.name != 'mako-control-plane' %}
  "storage": {
    "rocksdb_path": "{{ item.rocksdb_path }}",
    "maximum_batch_operations": 10000,
    "maximum_scan_items": 10000,
    "transaction_lock_timeout_seconds": 2,
    "transaction_expiration_seconds": 30,
    "backup_destination": "{{ item.backup_destination }}",
    "backup_retention_count": 14,
    "disk_warning_free_bytes": {{ mako_disk_warning_free_bytes }},
    "disk_critical_free_bytes": {{ mako_disk_critical_free_bytes }}
  },
{% else %}
  "control_storage": {
    "database_path": "{{ item.sqlite_database_path }}",
    "lock_path": "{{ item.sqlite_lock_path }}",
    "database_identity": "mako-control-plane-{{ mako_storage_region }}",
    "migration_workspace": "{{ item.sqlite_migration_workspace }}",
    "backup_staging": "{{ item.backup_destination }}",
    "backup_publish": "{{ item.backup_publish }}",
    "restore_workspace": "{{ item.restore_workspace }}",
    "reserve_path": "{{ item.reserve_path }}",
    "maximum_batch_operations": 10000,
    "maximum_scan_items": 10000,
    "busy_timeout_seconds": 2,
    "transaction_expiration_seconds": 30,
    "shutdown_timeout_seconds": 10,
    "wal_autocheckpoint_pages": 1000,
    "maximum_wal_bytes": 268435456,
    "integrity_interval_seconds": 900,
    "backup_retention_count": 14,
    "disk_warning_free_bytes": {{ mako_disk_warning_free_bytes }},
    "disk_critical_free_bytes": {{ mako_disk_critical_free_bytes }}
  },
{% endif %}
  "dependencies": {
    "smtp_address": "127.0.0.1:1025",
    "object_store_endpoint": "http://127.0.0.1:8333",
    "runtime_supervisor_address": "127.0.0.1:9001",
    "telemetry_query_address": "127.0.0.1:9465",
    "otlp_address": "127.0.0.1:4317"
  },
{% if item.name == 'mako-control-plane' %}
  "developer_registration": {
    "enabled": {{ mako_developer_registration_enabled | bool | lower }}{% if mako_developer_registration_enabled | bool %},
    "verification_lifetime_seconds": 86400,
    "recovery_lifetime_seconds": 3600,
    "access_lifetime_seconds": 900,
    "refresh_lifetime_seconds": 2592000,
    "decision_retention_seconds": 31536000,
    "rate_window_seconds": 60,
    "global_requests_per_window": 300,
    "source_requests_per_window": 20,
    "email_requests_per_window": 5,
    "token_attempts_per_window": 20,
    "maximum_parallel_password_work": 4,
    "maximum_pending_outbox": 5000,
    "maximum_outbox_batch": 50,
    "outbox_lease_seconds": 60,
    "outbox_maximum_attempts": 10,
    "outbox_maximum_backoff_seconds": 3600,
    "delivered_mail_retention_seconds": 604800,
    "smtp_relay_hostname": "{{ mako_developer_smtp_relay_hostname }}",
    "smtp_port": {{ mako_developer_smtp_port }},
    "smtp_tls_mode": "{{ mako_developer_smtp_tls_mode }}",
    "smtp_username": "{{ mako_developer_smtp_username }}",
    "smtp_sender": "{{ mako_developer_smtp_sender }}",
    "smtp_timeout_seconds": 10{% endif %}
  },
  "operator_authentication": {
    "enabled": {{ mako_operator_password_auth_enabled | bool | lower }},
    "session_lifetime_seconds": {{ mako_operator_session_lifetime_seconds }},
    "mutation_freshness_seconds": {{ mako_operator_mutation_freshness_seconds }},
    "attempt_window_seconds": {{ mako_operator_attempt_window_seconds }},
    "source_attempts_per_window": {{ mako_operator_source_attempts_per_window }},
    "identity_attempts_per_window": {{ mako_operator_identity_attempts_per_window }},
    "base_backoff_seconds": {{ mako_operator_base_backoff_seconds }},
    "maximum_backoff_seconds": {{ mako_operator_maximum_backoff_seconds }},
    "break_glass_bearer_enabled": {{ mako_operator_break_glass_bearer_enabled | bool | lower }}
  },
{% endif %}
  "limits": {
    "max_request_bytes": 16777216,
    "shutdown_grace_seconds": 30
  },
  "secrets": {
    "internal_auth": "file:/run/credentials/{{ item.name }}.service/internal-auth"{% if item.name in ['mako-control-plane', 'mako-data-plane'] %},
    "object_store_access_key": "file:/run/credentials/{{ item.name }}.service/object-store-access-key",
    "object_store_secret_key": "file:/run/credentials/{{ item.name }}.service/object-store-secret-key"{% endif %}{% if item.name == 'mako-control-plane' and mako_developer_registration_enabled | bool %},
    "developer_mail_encryption": "file:/run/credentials/mako-control-plane.service/developer-mail-encryption",
    "developer_smtp_password": "file:/run/credentials/mako-control-plane.service/developer-smtp-password"{% endif %}
  }
}
