[Unit]
Description=Mako Cloud {{ item.name }}
Documentation=https://cloud-test.makodb.com
Wants=network-online.target
After=network-online.target local-fs.target
{% if item.name == 'mako-control-plane' %}
Wants=mako-telemetry-query.service
After=mako-telemetry-query.service
{% endif %}
RequiresMountsFor=/opt/mako/current /etc/mako/services{{ (' ' ~ item.database_path) if item.database_path is defined else '' }}{% if item.control_paths is defined %} {{ item.control_paths | join(' ') }}{% endif %}
ConditionPathIsDirectory=/opt/mako/current
ConditionPathExists=/opt/mako/current/bin/{{ item.name }}
{% if item.service_config | default(true) %}
ConditionPathExists=/etc/mako/services/{{ item.name }}.json
{% endif %}
ConditionPathExists=/etc/mako/credentials/internal-auth
{% if item.name in ['mako-control-plane', 'mako-data-plane'] %}
ConditionPathExists=/etc/mako/credentials/object-store-access-key
ConditionPathExists=/etc/mako/credentials/object-store-secret-key
{% endif %}
{% if item.name == 'mako-control-plane' %}
{% if mako_developer_registration_enabled | bool %}
ConditionPathExists=/etc/mako/credentials/developer-mail-encryption
ConditionPathExists=/etc/mako/credentials/developer-smtp-password
{% endif %}
{% endif %}
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User={{ item.name }}
Group={{ item.name }}
WorkingDirectory=/opt/mako/current
{% if item.service_config | default(true) %}
Environment=MAKO_CONFIG_FILE=/etc/mako/services/{{ item.name }}.json
{% endif %}
{% if item.name == 'mako-telemetry-query' %}
Environment=MAKO_TELEMETRY_QUERY_BIND=127.0.0.1:9465
Environment=MAKO_TELEMETRY_REGION={{ mako_storage_region }}
Environment=MAKO_TELEMETRY_RETENTION_SECONDS=7776000
Environment=MAKO_TELEMETRY_DATABASE_PATH={{ item.database_path }}
Environment=MAKO_TELEMETRY_DATABASE_ID={{ item.database_id }}
Environment=MAKO_DISK_WARNING_FREE_BYTES={{ mako_disk_warning_free_bytes }}
Environment=MAKO_DISK_CRITICAL_FREE_BYTES={{ mako_disk_critical_free_bytes }}
LoadCredential=telemetry-authorization:/etc/mako/credentials/internal-auth
{% else %}
LoadCredential=internal-auth:/etc/mako/credentials/internal-auth
{% endif %}
{% if item.name in ['mako-control-plane', 'mako-data-plane'] %}
LoadCredential=object-store-access-key:/etc/mako/credentials/object-store-access-key
LoadCredential=object-store-secret-key:/etc/mako/credentials/object-store-secret-key
{% endif %}
{% if item.name == 'mako-control-plane' and mako_developer_registration_enabled | bool %}
LoadCredential=developer-mail-encryption:/etc/mako/credentials/developer-mail-encryption
LoadCredential=developer-smtp-password:/etc/mako/credentials/developer-smtp-password
{% endif %}
{% if item.database_path is defined and item.name != 'mako-control-plane' %}
ExecStartPre=/opt/mako/current/bin/mako-storage-ops provision --database-path={{ item.database_path }} --service={{ item.name }} --database-id={{ item.database_id }} --confirm=PROVISION --accept-matching-marker
{% endif %}
ExecStart=/opt/mako/current/bin/{{ item.name }}
Restart=on-failure
RestartSec=5s
TimeoutStartSec=60s
TimeoutStopSec=45s
KillSignal=SIGTERM
KillMode=mixed
SendSIGKILL=yes
OOMPolicy=stop
UMask=0077
RuntimeDirectory={{ item.name }}
RuntimeDirectoryMode=0750
LogsDirectory={{ item.name }}
LogsDirectoryMode=0750
{% if item.database_path is defined %}
ReadWritePaths={{ item.database_path }}
{% endif %}
{% if item.control_paths is defined %}
ReadWritePaths={{ item.control_paths | join(' ') }}
{% endif %}
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateIPC=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
IPAddressDeny=any
{% if item.name == 'mako-control-plane' and mako_developer_registration_enabled | bool %}
# The guest nftables policy remains default-deny and permits outbound SMTP only
# on the configured TLS relay ports. The relay's DNS-backed addresses can rotate,
# so the service-level address filter cannot safely pin individual destination IPs.
IPAddressAllow=any
{% elif item.name == 'mako-data-plane' %}
# Sign-in providers are the data plane's to run: it fetches the issuer's OIDC
# discovery document, redeems authorization codes, and reads signing keys at
# whatever public host the environment configured -- names an IP filter
# cannot express. The guest nftables policy stays the outbound bound
# (80/443, the SMTP relay ports, DNS); pinned to loopback, every provider
# sign-in answered `unavailable` in production while the qualification's
# loopback OIDC stub passed.
IPAddressAllow=any
{% else %}
IPAddressAllow=localhost
{% endif %}
SocketBindDeny=any
SocketBindAllow=ipv4:tcp:{{ item.port }}
DevicePolicy=closed
TasksMax=512
LimitNOFILE=1048576
MemoryMax={{ item.memory_max }}
CPUQuota={{ item.cpu_quota }}

[Install]
WantedBy=multi-user.target
