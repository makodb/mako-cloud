{
	admin off
{% if mako_acme_contact | length > 0 %}
	email {{ mako_acme_contact }}
{% endif %}
{% if mako_acme_environment == 'staging' %}
	acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
{% endif %}
}

{{ mako_public_fqdn }} {
	route {
	# The private service protocol is never a public reverse-proxy target.
	@internal_rpc path_regexp internal_rpc ^/_internal(?:/|$)
	respond @internal_rpc 404
	@service_credential_api path_regexp service_credential_api ^/v1/projects/[^/]+/environments/[^/]+/service(?:/|$)
	respond @service_credential_api 404

{% set admission_mode = mako_render_admission_mode | default(mako_public_admission_mode) %}
{% if admission_mode == 'disabled' %}
	# A disabled configuration remains safe even if Caddy is started manually.
	respond 503
{% else %}
{% if admission_mode == 'pre_gate' %}
	# ACME challenge handling occurs before this application handler. All other
	# HTTPS qualification traffic is restricted to explicit source networks.
	@outside_qualification_sources not remote_ip {{ (mako_management_cidrs + mako_tester_cidrs) | join(' ') }}
	respond @outside_qualification_sources 403
{% endif %}

	request_body {
		max_size 32MB
	}
	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
{% if mako_hsts_enabled | bool %}
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
{% else %}
		-Strict-Transport-Security
{% endif %}
	}

	# These path regular expressions are generated from and validated against
	# api/openapi/mako-cloud-v1.yaml. Unsupported methods reach the owning Mako
	# service and receive its stable 405 response; unrecognized paths do not.
	@data_api path_regexp data_api ^(?:/v1/projects/[^/]+/environments/[^/]+/auth/signup|/v1/projects/[^/]+/environments/[^/]+/auth/jwks|/v1/projects/[^/]+/environments/[^/]+/auth/signin|/v1/projects/[^/]+/environments/[^/]+/auth/token|/v1/projects/[^/]+/environments/[^/]+/auth/signout|/v1/projects/[^/]+/environments/[^/]+/auth/user|/v1/projects/[^/]+/environments/[^/]+/collections/[^/]+/documents/[^/]+|/v1/projects/[^/]+/environments/[^/]+/collections/[^/]+/documents/query|/v1/projects/[^/]+/environments/[^/]+/service/collections/[^/]+/documents/[^/]+|/v1/projects/[^/]+/environments/[^/]+/service/collections/[^/]+/documents/query|/v1/projects/[^/]+/environments/[^/]+/collections/[^/]+/replication/pull|/v1/projects/[^/]+/environments/[^/]+/collections/[^/]+/replication/push|/v1/projects/[^/]+/environments/[^/]+/collections/[^/]+/replication/stream)$
	@replication_stream path_regexp replication_stream ^/v1/projects/[^/]+/environments/[^/]+/collections/[^/]+/replication/stream$
	@control_api path_regexp control_api ^(?:/v1/developer-auth/registrations|/v1/developer-auth/verifications|/v1/developer-auth/verification-resends|/v1/developer-auth/sessions|/v1/developer-auth/sessions/refresh|/v1/developer-auth/sessions/current|/v1/developer-auth/password-recovery-requests|/v1/developer-auth/password-recoveries|/v1/developer-auth/wait-list-status|/v1/operator-auth/sessions|/v1/operator-auth/sessions/current|/v1/operator-auth/sessions/current/actions/verify-password|/v1/organizations|/v1/organizations/[^/]+|/v1/organizations/[^/]+/actions/restore|/v1/organizations/[^/]+/bill|/v1/organizations/[^/]+/invitations|/v1/invitations/[^/]+/accept|/v1/organizations/[^/]+/members|/v1/organizations/[^/]+/members/[^/]+|/v1/organizations/[^/]+/automation-tokens|/v1/organizations/[^/]+/automation-tokens/[^/]+|/v1/organizations/[^/]+/automation-tokens/[^/]+/actions/rotate|/v1/projects|/v1/projects/[^/]+|/v1/projects/[^/]+/actions/suspend|/v1/projects/[^/]+/actions/restore|/v1/projects/[^/]+/environments|/v1/projects/[^/]+/environments/[^/]+|/v1/projects/[^/]+/environments/[^/]+/actions/suspend|/v1/projects/[^/]+/environments/[^/]+/actions/restore|/v1/projects/[^/]+/environments/[^/]+/collections|/v1/projects/[^/]+/environments/[^/]+/collections/[^/]+|/v1/projects/[^/]+/environments/[^/]+/collections/[^/]+/schemas|/v1/projects/[^/]+/environments/[^/]+/collections/[^/]+/migrations|/v1/projects/[^/]+/environments/[^/]+/collections/[^/]+/migrations/[^/]+|/v1/projects/[^/]+/environments/[^/]+/collections/[^/]+/indexes|/v1/projects/[^/]+/environments/[^/]+/collections/[^/]+/indexes/[^/]+/[^/]+|/v1/projects/[^/]+/environments/[^/]+/collections/[^/]+/policies|/v1/projects/[^/]+/environments/[^/]+/collections/[^/]+/policies/[^/]+|/v1/projects/[^/]+/environments/[^/]+/collections/[^/]+/policies/[^/]+/actions/validate|/v1/projects/[^/]+/environments/[^/]+/collections/[^/]+/policies/[^/]+/actions/test|/v1/projects/[^/]+/environments/[^/]+/collections/[^/]+/policies/[^/]+/actions/activate|/v1/projects/[^/]+/environments/[^/]+/collections/[^/]+/policies/[^/]+/actions/rollback|/v1/projects/[^/]+/environments/[^/]+/users|/v1/projects/[^/]+/environments/[^/]+/users/invitations|/v1/projects/[^/]+/environments/[^/]+/users/[^/]+|/v1/projects/[^/]+/environments/[^/]+/users/[^/]+/actions/disable|/v1/projects/[^/]+/environments/[^/]+/users/[^/]+/actions/restore|/v1/projects/[^/]+/environments/[^/]+/users/[^/]+/actions/revoke-sessions|/v1/projects/[^/]+/environments/[^/]+/users/[^/]+/sessions/[^/]+|/v1/projects/[^/]+/environments/[^/]+/credentials/public|/v1/projects/[^/]+/environments/[^/]+/credentials/service|/v1/projects/[^/]+/environments/[^/]+/credentials/[^/]+|/v1/projects/[^/]+/environments/[^/]+/credentials/[^/]+/actions/rotate|/v1/projects/[^/]+/environments/[^/]+/signing-keys|/v1/projects/[^/]+/environments/[^/]+/signing-keys/actions/initialize|/v1/projects/[^/]+/environments/[^/]+/function-secrets|/v1/projects/[^/]+/environments/[^/]+/function-secrets/[^/]+|/v1/projects/[^/]+/environments/[^/]+/function-secrets/[^/]+/actions/rotate|/v1/projects/[^/]+/environments/[^/]+/observability/usage|/v1/projects/[^/]+/environments/[^/]+/observability/quotas|/v1/projects/[^/]+/environments/[^/]+/observability/health|/v1/projects/[^/]+/environments/[^/]+/observability/replication-errors|/v1/projects/[^/]+/environments/[^/]+/observability/auth-events|/v1/projects/[^/]+/environments/[^/]+/observability/function-metrics|/v1/projects/[^/]+/environments/[^/]+/observability/logs|/v1/projects/[^/]+/environments/[^/]+/observability/index-states|/v1/projects/[^/]+/environments/[^/]+/observability/audit-events|/v1/projects/[^/]+/environments/[^/]+/function-bundles|/v1/projects/[^/]+/environments/[^/]+/functions|/v1/projects/[^/]+/environments/[^/]+/functions/[^/]+|/v1/projects/[^/]+/environments/[^/]+/functions/[^/]+/versions|/v1/projects/[^/]+/environments/[^/]+/functions/[^/]+/versions/[^/]+|/v1/projects/[^/]+/environments/[^/]+/functions/[^/]+/versions/[^/]+/actions/promote|/v1/projects/[^/]+/environments/[^/]+/functions/[^/]+/versions/[^/]+/actions/health-check|/v1/projects/[^/]+/environments/[^/]+/functions/[^/]+/versions/[^/]+/actions/rollback|/v1/projects/[^/]+/environments/[^/]+/functions/[^/]+/actions/test|/v1/projects/[^/]+/environments/[^/]+/functions/[^/]+/logs|/v1/operator/developer-waitlist|/v1/operator/developer-waitlist/[^/]+|/v1/operator/developer-waitlist/[^/]+/actions/approve|/v1/operator/developer-waitlist/[^/]+/actions/reject|/v1/operator/projects/[^/]+|/v1/operator/projects/[^/]+/provisioning/[^/]+/actions/repair|/v1/operator/projects/[^/]+/quota-overrides|/v1/operator/projects/[^/]+/abuse-responses|/v1/operator/projects/[^/]+/support-sessions|/v1/operator/projects/[^/]+/support-sessions/[^/]+/actions/revoke)$
	@operator_control_api path_regexp operator_control_api ^(?:/v1/operator/overview|/v1/operator/tenants|/v1/operator/tenants/[^/]+|/v1/operator/inventory/[^/]+|/v1/operator/alerts|/v1/operator/alerts/[^/]+|/v1/operator/incidents|/v1/operator/incidents/[^/]+|/v1/operator/incidents/[^/]+/actions/update|/v1/operator/recovery-jobs|/v1/operator/recovery-jobs/[^/]+|/v1/operator/recovery-jobs/[^/]+/actions/advance|/v1/operator/activity|/v1/operator/activity-exports|/v1/operator/activity-exports/[^/]+|/v1/operator/activity-exports/[^/]+/actions/process|/v1/operator/projections/[^/]+/actions/rebuild|/v1/operator/security|/v1/operator/security/identities/[^/]+/sessions/actions/revoke|/v1/operator/security/entitlements/actions/plan|/v1/operator/security/entitlements/actions/apply|/v1/operator/support-sessions/current|/v1/operator/provisioning-workflows|/v1/operator/organizations/[^/]+/plan|/v1/operator/organizations/[^/]+/plan-exceptions|/v1/operator/projects/[^/]+/quota-overrides/[^/]+/actions/replace|/v1/operator/projects/[^/]+/quota-overrides/[^/]+/actions/revoke|/v1/operator/projects/[^/]+/abuse-responses/[^/]+/actions/restore)$
	@developer_workspace_api path_regexp developer_workspace_api ^(?:/v1/developer-auth/sessions/current/actions/verify-password|/v1/projects/[^/]+/restore-requests|/v1/projects/[^/]+/environments/[^/]+/explorer/grants|/v1/projects/[^/]+/environments/[^/]+/explorer/grants/[^/]+|/v1/projects/[^/]+/environments/[^/]+/explorer/collections/[^/]+/documents/[^/]+|/v1/projects/[^/]+/environments/[^/]+/explorer/collections/[^/]+/documents/[^/]+/history|/v1/projects/[^/]+/environments/[^/]+/explorer/collections/[^/]+/browse|/v1/projects/[^/]+/environments/[^/]+/explorer/collections/[^/]+/query|/v1/projects/[^/]+/environments/[^/]+/explorer/collections/[^/]+/query/plan|/v1/projects/[^/]+/environments/[^/]+/explorer/collections/[^/]+/simulate|/v1/projects/[^/]+/environments/[^/]+/explorer/collections/[^/]+/mutate|/v1/projects/[^/]+/environments/[^/]+/data-jobs|/v1/projects/[^/]+/environments/[^/]+/data-jobs/[^/]+|/v1/projects/[^/]+/environments/[^/]+/data-jobs/[^/]+/actions/cancel|/v1/projects/[^/]+/environments/[^/]+/data-jobs/[^/]+/actions/dry-run|/v1/projects/[^/]+/environments/[^/]+/data-jobs/[^/]+/actions/confirm|/v1/projects/[^/]+/environments/[^/]+/data-jobs/[^/]+/artifact-grants/upload|/v1/projects/[^/]+/environments/[^/]+/data-jobs/[^/]+/artifact-grants/download|/v1/projects/[^/]+/environments/[^/]+/data-jobs/[^/]+/artifact|/v1/projects/[^/]+/environments/[^/]+/workspace/summary|/v1/projects/[^/]+/environments/[^/]+/workspace/navigation|/v1/projects/[^/]+/environments/[^/]+/connect|/v1/projects/[^/]+/environments/[^/]+/connect/check|/v1/projects/[^/]+/environments/[^/]+/sync/summary|/v1/projects/[^/]+/environments/[^/]+/backups)$
	@developer_auth path_regexp developer_auth ^/v1/developer-auth(?:/|$)
	@operator_auth path_regexp operator_auth ^/v1/operator-auth(?:/|$)
	@edge_function path_regexp edge_function ^/[^/]+/functions/v1/[^/]+$

	reverse_proxy @replication_stream 127.0.0.1:8080 {
		flush_interval -1
	}
	reverse_proxy @data_api 127.0.0.1:8080
	header @developer_auth Cache-Control "no-store"
	header @operator_auth Cache-Control "no-store"
	reverse_proxy @control_api 127.0.0.1:8081 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}
	reverse_proxy @operator_control_api 127.0.0.1:8081 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}
	reverse_proxy @developer_workspace_api 127.0.0.1:8081 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}
	reverse_proxy @edge_function 127.0.0.1:8082 {
		flush_interval -1
	}

	# The release-owned console is served only on its documented client routes.
	@console_asset path_regexp console_asset ^/assets/[A-Za-z0-9._-]+\.(?:css|js)$
	handle @console_asset {
		root * /opt/mako/current/console
		file_server
	}
	@console_route path_regexp console_route ^(?:/|/login|/sign-in|/create-account|/check-email|/verify-email|/forgot-password|/check-recovery-email|/reset-password|/wait-list|/operator|/organizations/[^/]+|/invitations/[^/]+|/projects/[^/]+(?:/environments/[^/]+(?:/(?:collections(?:/[^/]+(?:/policies)?)?|users(?:/[^/]+)?|credentials|functions(?:/[^/]+)?|observability))?)?)$
	handle @console_route {
		root * /opt/mako/current/console
		rewrite * /index.html
		file_server
	}
	@console_workspace_route path_regexp console_workspace_route ^(?:/operator/(?:tenants(?:/[^/]+)?|operations|incidents|backups|sync|fleet|storage|security|activity|waitlist)|/projects/[^/]+/environments/[^/]+/(?:overview|data|connect|sync|backups|settings|explorer|api|replication|recovery))$
	handle @console_workspace_route {
		root * /opt/mako/current/console
		rewrite * /index.html
		file_server
	}

	respond 404
{% endif %}
	}
}
