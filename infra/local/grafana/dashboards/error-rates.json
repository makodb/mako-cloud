{
  "annotations": { "list": [] },
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "min": 0, "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "expr": "sum by (service) (rate(mako_requests_total{outcome=\"error\",project_id=~\"$project\",environment_id=~\"$environment\"}[5m])) / clamp_min(sum by (service) (rate(mako_requests_total{project_id=~\"$project\",environment_id=~\"$environment\"}[5m])), 0.000001)",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "title": "Request error ratio",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [
        {
          "expr": "sum by (service, error_class) (rate(mako_internal_errors_total{project_id=~\"$project\",environment_id=~\"$environment\"}[5m]))",
          "legendFormat": "{{service}} / {{error_class}}",
          "refId": "A"
        }
      ],
      "title": "Internal errors by safe class",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["mako-cloud", "errors"],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "includeAll": true,
        "name": "project",
        "query": "label_values(mako_requests_total, project_id)",
        "type": "query"
      },
      {
        "allValue": ".*",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "includeAll": true,
        "name": "environment",
        "query": "label_values(mako_requests_total{project_id=~\"$project\"}, environment_id)",
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "title": "Mako Cloud — Error Rates",
  "uid": "mako-error-rates",
  "version": 1
}
