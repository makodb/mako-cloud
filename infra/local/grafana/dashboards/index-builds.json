{
  "annotations": { "list": [] },
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "max": 100, "min": 0, "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "expr": "max by (collection_id, index_name, index_version) (mako_index_build_progress_percent{project_id=~\"$project\",environment_id=~\"$environment\"})",
          "legendFormat": "{{collection_id}} / {{index_name}} v{{index_version}}",
          "refId": "A"
        }
      ],
      "title": "Build progress",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [
        {
          "expr": "sum by (collection_id, index_name, reason) (increase(mako_index_build_failures_total{project_id=~\"$project\",environment_id=~\"$environment\"}[1h]))",
          "legendFormat": "{{collection_id}} / {{index_name}} / {{reason}}",
          "refId": "A"
        }
      ],
      "title": "Build failures in the last hour",
      "type": "table"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["mako-cloud", "index", "build"],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "includeAll": true,
        "name": "project",
        "query": "label_values(mako_index_build_progress_percent, project_id)",
        "type": "query"
      },
      {
        "allValue": ".*",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "includeAll": true,
        "name": "environment",
        "query": "label_values(mako_index_build_progress_percent{project_id=~\"$project\"}, environment_id)",
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "title": "Mako Cloud — Index Builds",
  "uid": "mako-index-builds",
  "version": 1
}
