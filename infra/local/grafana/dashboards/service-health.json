{
  "annotations": { "list": [] },
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": { "color": "red", "text": "Unavailable" },
                "1": { "color": "yellow", "text": "Degraded" },
                "2": { "color": "green", "text": "Healthy" }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "green", "value": 2 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "expr": "min by (service, region) (mako_service_health{project_id=~\"$project\",environment_id=~\"$environment\"})",
          "legendFormat": "{{service}} / {{region}}",
          "refId": "A"
        }
      ],
      "title": "Service readiness",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, service) (rate(mako_request_duration_milliseconds_bucket{project_id=~\"$project\",environment_id=~\"$environment\"}[5m])))",
          "legendFormat": "{{service}} p99",
          "refId": "A"
        }
      ],
      "title": "Request p99 latency",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["mako-cloud", "health"],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "includeAll": true,
        "label": "Project",
        "name": "project",
        "query": "label_values(mako_service_health, project_id)",
        "type": "query"
      },
      {
        "allValue": ".*",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "includeAll": true,
        "label": "Environment",
        "name": "environment",
        "query": "label_values(mako_service_health{project_id=~\"$project\"}, environment_id)",
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "title": "Mako Cloud — Service Health",
  "uid": "mako-service-health",
  "version": 1
}
