#!/usr/bin/env bash
set -euo pipefail

backup_root=/var/lib/vz/dump/mako-cloud-public-beta
retention_count=14

[[ -d "$backup_root" && ! -L "$backup_root" ]] || {
  echo "public-beta backup root is unavailable" >&2
  exit 1
}

for component in data-plane control-plane; do
  component_root="${backup_root}/${component}"
  [[ -d "$component_root" && ! -L "$component_root" ]] || {
    echo "public-beta backup component root is unavailable" >&2
    exit 1
  }
  mapfile -t backups < <(
    /usr/bin/find "$component_root" -mindepth 1 -maxdepth 1 -type d \
      -regextype posix-extended \
      -regex ".*/[0-9]{8}T[0-9]{6}Z-${component}" \
      -print | /usr/bin/sort --reverse
  )
  if (( ${#backups[@]} <= retention_count )); then
    continue
  fi
  for backup in "${backups[@]:retention_count}"; do
    [[ "$(/usr/bin/dirname -- "$backup")" == "$component_root" ]] || {
      echo "refusing to prune a backup outside its component root" >&2
      exit 1
    }
    /usr/bin/rm -rf -- "$backup"
  done
done
